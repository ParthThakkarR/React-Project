# ============================================================
#  Copy this file to backend/.env and fill in your values.
#  NEVER commit the real .env to git.
# ============================================================

# MongoDB Atlas connection string (free M0 cluster)
# Get it from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# Express server port (must match Dockerfile EXPOSE)
PORT=5000

# JWT secret — generate a strong random string:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
